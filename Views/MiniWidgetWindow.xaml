<Window x:Class="EcoPowerMonitor.Views.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EcoPower Mini HUD"
        Height="66" Width="370"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Icon="/app.ico"
        FontFamily="{StaticResource PrimaryFont}">

    <Window.Resources>
        <!-- Mini HUD Action Button Style (Pin / Expand) -->
        <Style x:Key="MiniHudActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHighlightBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CyanAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini HUD Close Button Style (Red Hover) -->
        <Style x:Key="MiniHudCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C4101F" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#C4101F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBgBrush}" 
            BorderBrush="{DynamicResource ButtonBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="14,8"
            MouseLeftButtonDown="Window_MouseLeftButtonDown"
            Cursor="SizeAll"
            ToolTip="คลิกซ้ายค้างเพื่อลากย้าย • ดับเบิลคลิกเพื่อขยายเป็นหน้าต่างหลัก">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.38" Color="#000000" />
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. Total Power & Real-time Live Cost -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBoltGeometry}" 
                          Fill="{DynamicResource AmberAccentBrush}" 
                          Stretch="Uniform" 
                          Width="13" Height="13" 
                          Margin="0,0,5,0" VerticalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect Color="#F59E0B" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                        </Path.Effect>
                    </Path>
                    <TextBlock Text="{Binding FormattedDisplayedWatts, StringFormat='{}{0} W'}" 
                               FontWeight="Bold" FontSize="18" 
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding FormattedMiniCostText}" 
                           FontSize="10" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           Margin="18,1,0,0" />
            </StackPanel>

            <!-- 2. CPU & GPU Temp Badges with Smart Thermal Alert -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- CPU Temp Badge -->
                <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentReading.IsHighTemp}" Value="True">
                                    <Setter Property="Background" Value="#33EF4444" />
                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CPU " FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentReading.CpuTemperature, StringFormat='{}{0:F0}°'}" 
                                   FontWeight="Bold" FontSize="11" 
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- GPU Temp Badge -->
                <Border CornerRadius="6" Padding="7,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentReading.IsHighTemp}" Value="True">
                                    <Setter Property="Background" Value="#33EF4444" />
                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GPU " FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentReading.GpuTemperature, StringFormat='{}{0:F0}°'}" 
                                   FontWeight="Bold" FontSize="11" 
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Actions: Pin / Expand / Safe Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Arrow">
                <!-- Pin / Always on Top Toggle -->
                <Button x:Name="BtnPin" 
                        Style="{StaticResource MiniHudActionButtonStyle}" 
                        Margin="0,0,5,0" 
                        Click="BtnPin_Click" 
                        ToolTip="{Binding LMiniPin}">
                    <TextBlock x:Name="TxtPin" Text="📌" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Expand back to full Dashboard -->
                <Button Style="{StaticResource MiniHudActionButtonStyle}" 
                        Margin="0,0,5,0" 
                        Click="BtnExpand_Click" 
                        ToolTip="{Binding LMiniExpand}">
                    <Path Data="{StaticResource IconDashboardGeometry}" 
                          Fill="{DynamicResource TextPrimaryBrush}" 
                          Stretch="Uniform" 
                          Width="11" Height="11" />
                </Button>

                <!-- Close / Graceful Tray or Exit -->
                <Button Style="{StaticResource MiniHudCloseButtonStyle}" 
                        Click="BtnClose_Click" 
                        ToolTip="{Binding LMiniClose}">
                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
